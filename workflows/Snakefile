# workflows/Snakefile
# Build base Wflow + SFINCS models for all cities defined in config/cities.yml

configfile: "config/cities.yml"

from pathlib import Path

def cities():
    return list(config.get("cities", {}).keys())

def wflow_cities():
    return [
        c for c in cities()
        if config["cities"][c].get("wflow", {}).get("enabled", True)
    ]

def sfincs_models(city):
    return list(config["cities"][city].get("sfincs", {}).keys())


def sfincs_region(wildcards):
    return config["cities"][wildcards.city]["sfincs"][wildcards.sfmodel]["region"]


def sfincs_build_base(wildcards):
    return config["cities"][wildcards.city]["sfincs"][wildcards.sfmodel]["build_config"]


def sfincs_build_overrides(wildcards):
    cfg = config["cities"][wildcards.city]["sfincs"][wildcards.sfmodel]
    files = [cfg["build_config"]]
    if cfg.get("build_overrides"):
        files.append(cfg["build_overrides"])
    return files

def model_group(city, sfmodel):
    return BASE_CFG["cities"][city]["sfincs"][sfmodel].get("group", "default")


sfincs_pairs = [
    (city, model)
    for city in cities()
    for model in config["cities"][city].get("sfincs", {})
]

sfincs_cities = []
sfincs_models_list = []


for city in cities():
    for m in config["cities"][city].get("sfincs", {}):
        sfincs_cities.append(city)
        sfincs_models_list.append(m)


rule all:
    input:
        expand(
            "outputs/{city}/sfincs_base/{sfmodel}/sfincs.inp",
            zip,
            city=[c for c, m in sfincs_pairs],
            sfmodel=[m for c, m in sfincs_pairs],
        )


# rule build_wflow_base:
#     output:
#         touch(WFLOW_SENTINEL)
#     params:
#         cfg="config/cities.yml"
#     shell:
#         r"""
#         set -euo pipefail
#         python workflows/scripts/build_wflow.py --config {params.cfg} --city {wildcards.city}
#         """


rule build_sfincs_model:
    input:
        region=sfincs_region,
        build_base="config/templates/sfincs/build_base.yml",
        build_overrides=sfincs_build_overrides
    output:
        model_root = "outputs/{city}/sfincs_base/{sfmodel}/sfincs.inp"
    log:
        "logs/sfincs/{city}_{sfmodel}.log"
    params:
        cfg="config/cities.yml"
    script:
        "scripts/build_sfincs.py"
 

